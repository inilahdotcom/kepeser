# Wajib: kunci enkripsi cookie sesi, minimal 32 karakter.
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=ganti-dengan-32-karakter-acak-atau-lebih

DATABASE_URL=./data/kepeser.db
# Lampiran gambar. Menumpang volume yang sama dengan DB supaya ikut ter-backup.
UPLOAD_DIR=./data/uploads

# Domain email yang boleh mendaftar sendiri di /daftar. Kosongkan = bebas.
ALLOWED_EMAIL_DOMAIN=inilah.com

# Alamat publik aplikasi — dipakai merakit tautan reset password.
# WAJIB diisi di produksi: tautan TIDAK PERNAH diambil dari header Host, karena
# penyerang bisa memalsukannya dan membajak token reset.
APP_URL=http://localhost:3000

# SMTP untuk email reset password. Kalau SMTP_HOST kosong, tautannya dicetak ke
# log server (berguna saat dev; di produksi artinya email tidak terkirim).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Kepeser <no-reply@inilah.com>

# Akun supervisor pertama — dibuat saat boot kalau tabel users masih kosong.
SEED_SUPERVISOR_EMAIL=supervisor@inilah.com
SEED_SUPERVISOR_PASSWORD=ubah-password-ini
SEED_SUPERVISOR_NAME=IT Supervisor
